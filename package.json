{
  "name": "smeargraph",
  "version": "1.0.0",
  "description": "🖌️ Paint code architecture like Smeargle — scan source code, extract symbols, group components, trace data flows, render ASCII/HTML diagrams, serve via MCP, enrich with LLM. Zero-config, AI-agent ready.",
  "main": "dist/index.js",
  "bin": {
    "smeargraph": "dist/cli.js"
  },
  "files": [
    "dist",
    "agents",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "architecture",
    "code-analysis",
    "ascii-art",
    "visualization",
    "codebase",
    "cli",
    "developer-tools",
    "software-architecture",
    "reverse-engineering",
    "documentation",
    "knowledge-graph",
    "mcp",
    "mcp-server",
    "llm",
    "code-intelligence"
  ],
  "author": "GetIT-Sunday",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GetIT-Sunday/SmearGraph"
  },
  "homepage": "https://github.com/GetIT-Sunday/SmearGraph#readme",
  "bugs": {
    "url": "https://github.com/GetIT-Sunday/SmearGraph/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
