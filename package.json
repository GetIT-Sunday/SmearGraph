{
  "name": "smeargraph",
  "version": "1.0.0",
  "description": "🖌️ Paint code architecture like Smeargle — scan source code, extract symbols, group components, trace data flows, render ASCII/HTML diagrams, serve via MCP, enrich with LLM. Zero-config, AI-agent ready.",
  "main": "dist/index.js",
  "bin": {
    "smeargraph": "dist/cli.js"
  },
  "files": [
    "dist",
    "agents",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "architecture",
    "code-analysis",
    "ascii-art",
    "visualization",
    "codebase",
    "cli",
    "developer-tools",
    "software-architecture",
    "reverse-engineering",
    "documentation",
    "knowledge-graph",
    "mcp",
    "mcp-server",
    "llm",
    "code-intelligence"
  ],
  "author": "GetIT-Sunday",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GetIT-Sunday/SmearGraph"
  },
  "homepage": "https://github.com/GetIT-Sunday/SmearGraph#readme",
  "bugs": {
    "url": "https://github.com/GetIT-Sunday/SmearGraph/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}
